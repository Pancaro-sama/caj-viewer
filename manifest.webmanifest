{
  "name": "CAJ 阅读器 · 本地浏览器版",
  "short_name": "CAJ 阅读器",
  "description": "纯前端、零后端的 CAJ / KDH / HN / C8 / PDF 阅读器，解析与渲染都在本机完成。",
  "lang": "zh-CN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f2f3f5",
  "theme_color": "#2f6fed",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    {
      "src": "./app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./app/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/x-caj": [".caj", ".kdh", ".hn", ".nh", ".c8"],
        "application/pdf": [".pdf"]
      }
    }
  ]
}
